# Copy to .env only if your shell or secret manager loads it. This project does
# not parse .env files and .env is ignored by Git.
MODEL_SERVING_BASE_URL=http://127.0.0.1:8000
MODEL_SERVING_API_KEY=replace-with-user-api-key
MODEL_SERVING_ADMIN_API_KEY=replace-with-admin-api-key
# Must be a safe, read-only GET endpoint protected by the admin key.
MODEL_SERVING_ADMIN_PATH=/hicache/storage-backend

